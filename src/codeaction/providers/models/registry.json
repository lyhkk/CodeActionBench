{
  "registry_version": "0.7.0",
  "schema_version": "0.1",
  "_comment": [
    "Non-secret model declarations are hashed into identity.comparison.model.",
    "Credentials are resolved from a private 0600 file using the declared credential alias.",
    "Models using an existing protocol can be added with a registry entry; capabilities.source",
    "records the source of context and output limits. New protocols require an adapter.",
    "Reasoning effort and returned reasoning text are separate settings. Each model declares",
    "its supported profiles and capture channel. Anthropic thinking.display=summarized enables",
    "summary text; omitted yields empty thinking text without disabling reasoning or its billing."
  ],
  "models": {
    "qwen3.7-plus": {
      "protocol": "openai-compatible",
      "credential": "qwen",
      "capabilities": {
        "context_window_tokens": 1000000,
        "max_output_tokens": 8192,
        "token_estimator_id": "utf8-bytes-v1",
        "source": "Benchmark reference-scaffold configuration in use since 2026-07."
      },
      "reasoning_capture": {
        "channel": "reasoning_content",
        "expected_rungs": [
          "low",
          "medium",
          "high"
        ],
        "note": "DashScope returns thinking in message.reasoning_content when enable_thinking is true; observed on every model turn in a benchmark run on 2026-08-07."
      },
      "default_reasoning_profile": "disabled",
      "reasoning_profiles": {
        "disabled": {
          "id": "qwen3.7-plus-nonthinking-v2",

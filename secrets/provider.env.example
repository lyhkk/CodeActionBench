# Copy outside the repository. Uncomment only the providers you use.
# Values are literal: no export, quotes, or shell expansion.
# ANTHROPIC_KEY=
# OPENAI_KEY=
# GOOGLE_GEMINI_KEY=
# KIMI_KEY=
# KIMI_BASE_URL=
# QWEN_KEY=
# QWEN_BASE_URL=
# XAI_KEY=
# XAI_BASE_URL=
# The three BASE_URL values above are required for their providers.
# Use the OpenAI-compatible API endpoint issued with each key.
# Optional endpoint override, for example:
# OPENAI_BASE_URL=https://api.openai.com/v1
